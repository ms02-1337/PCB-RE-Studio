{
  "name": "pcb-re-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:desktop": "wdio run wdio.conf.ts",
    "desktop:build": "tauri build --debug --no-bundle --features desktop-test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@solidjs/testing-library": "^0.8.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^24.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/globals": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "@wdio/tauri-service": "^1.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.0.0"
  }
}
