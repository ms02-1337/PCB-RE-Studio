.visual-panel { display:flex; flex-direction:column; height:100%; min-height:0; width:100%; }
.ve-toolbar { display:flex; align-items:center; flex-shrink:0; gap:5px; padding:6px; border-bottom:1px solid var(--border); overflow-x:auto; }
.ve-toolbar button { white-space:nowrap; }
.ve-body { display:flex; flex:1; min-height:0; min-width:0; overflow:hidden; }
.ve-sidebar { flex-shrink:0; background:var(--surface); min-height:0; display:flex; flex-direction:column; overflow:hidden; padding:0; min-width:0; resize:none; }
.ve-heading { display:flex; align-items:center; justify-content:space-between; height:34px; flex-shrink:0; padding:3px 6px; border-bottom:1px solid var(--border); }
.ve-heading h2 { font-size:11px; font-weight:600; margin:0; }
.ve-heading button { padding:2px 5px; }
.ve-resizer { flex:0 0 5px; cursor:col-resize; background:var(--border); }
.ve-resizer:focus-visible { background:var(--accent); }
.ve-layer-count { display:flex; gap:8px; align-items:center; padding:8px; }
.ve-copper-defaults { display:flex; flex-direction:column; gap:2px; margin-top:14px; padding-top:10px; border-top:1px solid var(--border); }
.ve-copper-defaults h3 { margin:0 0 6px; padding:0 8px; font-size:11px; font-weight:500; text-transform:uppercase; letter-spacing:0.7px; color:var(--muted); }
.ve-copper-defaults label { display:flex; gap:8px; align-items:center; justify-content:space-between; padding:6px 8px; }
.ve-copper-defaults input[type="number"] { min-width:0; width:68px; }
.ve-layer-count input { min-width:0; width:68px; }
.ve-image-list { overflow:auto; overscroll-behavior:contain; padding:6px; flex:1; min-height:0; min-width:0; }
.ve-image-card { width:100%; min-width:0; box-sizing:border-box; border:1px solid var(--border); padding:6px; margin-bottom:7px; background:var(--bg); border-radius:3px; }
.ve-image-card.selected { border-color:var(--indicator); }
.ve-card-header { display:flex; gap:3px; align-items:center; }
.ve-icon { padding:3px; flex:0 0 24px; }
.ve-icon .action-icon { margin:0; }
.ve-image-name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; flex:1; min-width:0; text-align:left; padding:3px; border-color:transparent; }
.ve-card-header>input { min-width:0; width:0; flex:1; }
.ve-card-options { display:flex; gap:8px; align-items:start; margin-top:8px; }
.ve-card-options>label { display:flex; align-items:center; gap:5px; flex:1; min-width:0; }
.ve-card-options select { min-width:0; width:100%; }
.ve-flip { position:relative; }
.ve-flip summary { padding:3px 5px; border:1px solid var(--border); cursor:pointer; }
.ve-flip>div { display:flex; flex-direction:column; }
.ve-flip label { display:flex; align-items:center; font-size:11px; }
.ve-opacity { display:flex; align-items:center; gap:6px; margin-top:8px; font-size:11px; }
.ve-opacity input { min-width:0; flex:1; width:50px; accent-color:var(--accent); }
.ve-opacity output { min-width:32px; text-align:right; }
.ve-canvas { position:relative; flex:1; min-width:120px; overflow:hidden; background:var(--bg); }
.ve-canvas canvas { width:100%; height:100%; display:block; touch-action:none; }
.ve-view-controls { position:absolute; left:8px; bottom:8px; display:flex; gap:4px; }
.ve-view-controls button { background:var(--surface); }
.ve-canvas-empty { position:absolute; inset:40% 15px auto; text-align:center; color:var(--muted); pointer-events:none; }
.ve-tabs { display:flex; align-items:center; gap:4px; padding:4px 8px; border-top:1px solid var(--border); overflow:hidden; flex-shrink:0; }
.ve-tabs button { padding:3px 10px; font-size:12px; line-height:1.2; white-space:nowrap; }
.ve-tabs button[aria-current=true] { border-color:var(--indicator); }
.ve-error { margin:0; padding:6px; color:var(--danger); }
@media(max-width:1000px) { .ve-sidebar { max-width:27vw; } }
.ve-load-error { position:absolute; left:10px; top:10px; color:var(--danger); background:var(--surface); padding:6px; }
.ve-sidebar { max-width:calc((100% - 130px) / 2); }

.ve-settings-button { margin-left:auto; flex-shrink:0; }
.ve-settings-button .action-icon { margin-right:0; }
/* Add-image lives in the Images heading (space-between with the h2 and the
   collapse chevron); margin-left:auto pushes it right, next to the chevron. */
.ve-add-image { margin-left:auto; }
.ve-add-image .action-icon { margin-right:0; }
.ve-settings-dialog { width:360px; max-width:100%; padding:0; }

.ve-reorder { cursor:grab; touch-action:none; user-select:none; }
.ve-reorder:active { cursor:grabbing; }
.ve-image-card.is-dragging { opacity:0.55; }
.ve-image-card.is-drop-target { outline:2px solid var(--indicator); outline-offset:-2px; background:var(--raised); }
.ve-lock.is-locked, .ve-lock.is-locked:hover { background:var(--accent); color:#181818; border-color:var(--indicator); box-shadow:inset 0 0 0 1px var(--indicator); }

/* Tool toolbar toggling (tools + view flips) */
.ve-toolbar button[aria-pressed="true"] { border-color:var(--indicator); background:var(--accent); color:#181818; }
.ve-toolbar button .action-icon { margin-right:0; }
.ve-tool-separator { width:1px; align-self:stretch; margin:4px 3px; background:var(--border); flex-shrink:0; }
.ve-toast { position:absolute; left:50%; bottom:44px; transform:translateX(-50%); background:var(--surface); border:1px solid var(--border); padding:5px 12px; border-radius:4px; pointer-events:none; z-index:2; white-space:nowrap; }

/* Value prompt modal */
.ve-value-dialog { width:380px; max-width:100%; padding:0; }
.ve-value-message { margin:0 0 12px; }
.ve-value-field { display:flex; flex-direction:column; gap:5px; font-size:12px; color:var(--muted); }
.ve-value-field input { margin-bottom:0; }
.ve-value-error { color:var(--danger); margin:8px 0 0; font-size:12px; }
.ve-value-confirm { background:var(--accent); color:#181818; border-color:var(--accent); }
.ve-value-confirm:hover:not(:disabled) { background:color-mix(in srgb, var(--accent, #ffcd11) 88%, #fff); border-color:#fff; color:#181818; }

/* Join connected nets dialog */
.ve-join-dialog { width: min(520px, 92vw); max-width: 100%; }
.ve-join-explanation { font-size: 13px; line-height: 1.5; color: var(--text); margin: 0 0 16px !important; }
.ve-join-buttons { display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px; }
.ve-join-net-btn {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
  padding: 10px 14px;
  border: 1px solid var(--border);
  border-radius: 4px;
  background: var(--surface);
  color: var(--text);
  cursor: pointer;
  gap: 4px;
  transition: background 0.15s, border-color 0.15s;
}
.ve-join-net-btn:hover {
  background: var(--raised);
  border-color: var(--accent, #ffcd11);
}
.ve-join-btn-arrow {
  font-weight: 600;
  font-size: 13px;
  color: var(--accent, #ffcd11);
  display: flex;
  align-items: center;
  gap: 6px;
}
.ve-join-btn-desc {
  font-size: 12px;
  color: var(--muted);
}
.ve-join-btn-desc strong {
  color: var(--text);
}
.ve-join-divider {
  display: flex;
  align-items: center;
  margin: 16px 0 12px;
  color: var(--muted);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.6px;
}
.ve-join-divider::before,
.ve-join-divider::after {
  content: "";
  flex: 1;
  border-bottom: 1px solid var(--border);
}
.ve-join-divider span {
  padding: 0 10px;
}
.ve-join-custom-field {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 12px;
  color: var(--muted);
  margin-top: 4px;
}
.ve-join-label-text {
  font-weight: 500;
  color: var(--text);
  margin-bottom: 2px;
}
.ve-join-custom-row {
  display: flex;
  gap: 8px;
  align-items: center;
}
.ve-join-custom-input {
  flex: 1;
  min-width: 0;
  padding: 6px 10px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 3px;
  color: var(--text);
  font-size: 13px;
  outline: none;
  margin-bottom: 0 !important;
}
.ve-join-custom-input:focus {
  border-color: var(--focus);
  outline: 1px solid var(--focus);
}
.ve-join-custom-btn {
  white-space: nowrap;
  padding: 6px 12px;
  font-size: 12px;
  border: 1px solid var(--border);
  border-radius: 3px;
  background: var(--surface);
  color: var(--text);
  cursor: pointer;
}
.ve-join-custom-btn:hover:not(:disabled) {
  background: var(--raised);
  border-color: var(--accent);
}
.ve-join-custom-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}
.ve-copper-inspector { display: grid; gap: 12px; padding: 12px; overflow: auto; }
.ve-copper-inspector label { display: grid; gap: 4px; }
.ve-copper-inspector input, .ve-copper-inspector select { min-width: 0; width: 100%; }
.ve-net-selector { position: relative; display: flex; flex-direction: column; gap: 6px; }
.ve-net-selector-header { display: flex; justify-content: space-between; align-items: center; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); }
.ve-net-current-badge { font-weight: 600; text-transform: none; letter-spacing: normal; color: var(--text); display: inline-flex; align-items: center; gap: 5px; }
.ve-net-input-bar { display: flex; gap: 4px; align-items: center; position: relative; }
.ve-net-input-bar input { flex: 1; min-width: 0; width: auto !important; height: 28px; padding: 4px 8px; font-size: 12px; }
.ve-net-add-btn { flex: 0 0 28px; height: 28px; width: 28px; padding: 0; display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: bold; cursor: pointer; }
.ve-net-dropdown { position: absolute; top: 100%; left: 0; right: 0; z-index: 50; margin-top: 3px; max-height: 180px; overflow-y: auto; border: 1px solid var(--border); border-radius: 4px; background: var(--surface); box-shadow: 0 8px 24px var(--shadow); display: flex; flex-direction: column; padding: 3px; gap: 1px; }
.ve-net-item { display: flex; align-items: center; gap: 8px; padding: 5px 8px; border-radius: 2px; font-size: 12px; cursor: pointer; border: 0; background: transparent; color: var(--text); text-align: left; width: 100%; box-sizing: border-box; min-height: 25px; }
.ve-net-item:hover { background: var(--raised); }
.ve-net-item[data-selected="true"] { background: color-mix(in srgb, var(--accent, #ffcd11) 20%, transparent); font-weight: 600; }
.ve-net-item[data-selected="true"]:hover { background: color-mix(in srgb, var(--accent, #ffcd11) 30%, transparent); }
.ve-net-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; border: 1px solid rgba(0, 0, 0, 0.2); }
.ve-net-dot.unassigned { background: var(--muted); opacity: 0.5; }
.ve-net-item-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ve-net-check { font-size: 11px; color: var(--accent, #ffcd11); font-weight: bold; }
.ve-net-empty { padding: 10px 8px; color: var(--muted); font-size: 11px; text-align: center; font-style: italic; }
.ve-toolbar { flex-wrap: wrap; }
/* Nets panel layout */
.ve-nets {
  height: 100%;
  overflow: auto;
  padding: 16px 20px;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.ve-nets-header {
  display: flex;
  flex-direction: column;
  gap: 16px;
  border-bottom: 1px solid var(--border);
  padding-bottom: 18px;
}
.ve-nets-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}
.ve-nets-title-group {
  display: flex;
  align-items: baseline;
  gap: 12px;
}
.ve-nets-title-group h1 {
  margin: 0;
  font-size: 26px;
  font-weight: 600;
}
.ve-nets-count {
  font-size: 13px;
  color: var(--muted);
}
.ve-nets-pcb-control {
  display: flex;
  align-items: center;
  gap: 10px;
}
.ve-nets-pcb-control label {
  font-size: 13px;
  font-weight: 600;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.ve-nets-pcb-select {
  font-size: 14px;
  height: 36px;
  min-width: 180px;
  padding: 6px 30px 6px 12px !important;
  font-weight: 500;
}
.ve-nets-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}
.ve-nets-search {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1 1 240px;
  max-width: 400px;
}
.ve-nets-search label {
  font-size: 12px;
  color: var(--muted);
  white-space: nowrap;
}
.ve-nets-search input {
  flex: 1;
  height: 32px;
  font-size: 13px;
}
.ve-nets-create-form {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1 1 320px;
  justify-content: flex-end;
}
.ve-nets-create-form label {
  font-size: 12px;
  color: var(--muted);
  white-space: nowrap;
}
.ve-nets-create-form input {
  width: 180px;
  height: 32px;
  font-size: 13px;
}
.ve-nets-create-form button {
  height: 32px;
  padding: 0 14px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  font-weight: 500;
}

/* Nets Table */
.ve-nets-table-wrapper {
  overflow-x: auto;
  border: 1px solid var(--border);
  border-radius: 4px;
  background: var(--surface);
}
.ve-nets-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  font-size: 13px;
}
.ve-nets-table th {
  background: var(--raised);
  padding: 10px 12px;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--muted);
  border-bottom: 1px solid var(--border);
  white-space: nowrap;
}
.ve-nets-table td {
  padding: 8px 12px;
  border-bottom: 1px solid var(--border);
  vertical-align: middle;
}
.ve-nets-table tr:last-child td {
  border-bottom: 0;
}
.ve-nets-table tr:hover td {
  background: color-mix(in srgb, var(--raised) 50%, transparent);
}
.ve-nets-table .col-color {
  width: 44px;
  text-align: center;
}
.ve-nets-table .col-color input[type="color"] {
  width: 28px;
  height: 24px;
  padding: 1px;
  border-radius: 3px;
  border: 1px solid var(--border);
  background: transparent;
  cursor: pointer;
}
.ve-nets-table .col-name {
  min-width: 160px;
}
.ve-net-title-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: transparent;
  border: 0;
  padding: 4px 6px;
  color: var(--text);
  cursor: pointer;
  border-radius: 3px;
  font-weight: 500;
  font-size: 13px;
  text-align: left;
}
.ve-net-title-btn:hover {
  background: var(--raised);
  color: var(--accent);
}
.ve-net-name-label {
  font-weight: 600;
}
.ve-net-pill {
  font-size: 11px;
  padding: 1px 6px;
  border-radius: 10px;
  background: var(--raised);
  color: var(--muted);
  font-weight: normal;
}
.ve-nets-table .col-stat {
  width: 60px;
  text-align: center;
  font-variant-numeric: tabular-nums;
  color: var(--muted);
}
.ve-nets-table .col-merge {
  width: 200px;
}
.ve-net-merge-group {
  display: flex;
  gap: 6px;
  align-items: center;
}
.ve-net-merge-group select {
  flex: 1;
  height: 28px;
  font-size: 12px;
}
.ve-net-merge-group button {
  height: 28px;
  padding: 0 10px;
  font-size: 12px;
}
.ve-nets-table .col-actions {
  width: 240px;
}
.ve-net-actions-group {
  display: flex;
  gap: 6px;
  align-items: center;
}
.ve-net-rename {
  width: 110px;
  height: 28px;
  font-size: 12px;
  padding: 2px 6px;
}
.ve-net-actions-group button.danger {
  height: 28px;
  padding: 0 8px;
  font-size: 12px;
  white-space: nowrap;
}
.ve-nets-empty {
  padding: 32px 16px;
  text-align: center;
  color: var(--muted);
  font-style: italic;
}

/* Net Elements Modal (standardized to TypeManager dialog pattern) */
.palette.type-manager.ve-net-modal {
  width: min(1200px, 95vw);
  height: min(760px, calc(100dvh - 48px));
  max-height: calc(100dvh - 48px);
}
.ve-net-modal-title {
  display: flex;
  align-items: center;
  gap: 10px;
}
.ve-net-modal-title h2 {
  margin: 0;
  font-size: 15px;
  font-weight: 600;
}
.ve-net-count-pill {
  font-size: 11px;
  padding: 1px 7px;
  border-radius: 10px;
  background: var(--bg);
  border: 1px solid var(--border);
  color: var(--muted);
  font-weight: 500;
}
.ve-net-elements-table {
  width: 100%;
}
.ve-net-elements-table th.col-el-type,
.ve-net-elements-table td.col-el-type {
  width: 70px;
  text-align: center;
}
.ve-net-elements-table th.col-el-name,
.ve-net-elements-table td.col-el-name {
  width: 440px;
  min-width: 360px;
  text-align: left;
}
.ve-net-elements-table th.col-el-layer,
.ve-net-elements-table td.col-el-layer {
  width: 120px;
  text-align: left;
}
.ve-net-elements-table th.col-el-comment,
.ve-net-elements-table td.col-el-comment {
  width: 340px;
  max-width: 380px;
  text-align: left;
}
.ve-net-elements-table th.col-el-actions,
.ve-net-elements-table td.col-el-actions {
  width: 140px;
  text-align: right;
}
.ve-element-badge {
  font-size: 11px;
  padding: 2px 6px;
  border-radius: 3px;
  background: var(--surface);
  border: 1px solid var(--border);
  color: var(--muted);
  font-weight: 600;
  text-transform: uppercase;
}
.ve-element-goto-link {
  background: transparent;
  border: 0;
  padding: 0;
  font-weight: 600;
  color: var(--text);
  cursor: pointer;
  text-align: left;
  white-space: nowrap;
}
.ve-element-goto-link:hover {
  color: var(--accent);
  text-decoration: underline;
}
.type-manager .ve-element-comment {
  width: 100%;
  height: 26px;
  font-size: 12px;
  padding: 2px 8px;
  box-sizing: border-box;
  background-color: var(--bg);
  border: 1px solid var(--border);
  border-radius: 3px;
  color: var(--text);
  outline: none;
  margin-bottom: 0;
}
.type-manager .ve-element-comment:focus {
  border-color: var(--focus);
  outline: 1px solid var(--focus);
}
.ve-element-action-btn {
  height: 26px;
  padding: 0 10px;
  font-size: 12px;
  white-space: nowrap;
}
.ve-element-action-btn:hover {
  background: var(--accent);
  color: #181818;
}
.ve-element-action-btn:hover {
  background: var(--accent);
  color: #181818;
}
.palette.component-manager, .component-manager{width:min(1013px,95vw);height:min(760px,88vh);min-height:min(420px,66vh);max-height:92vh;display:flex;flex-direction:column}.component-manager-body{display:grid;grid-template-columns:240px 1fr;flex:1;overflow:auto;min-height:0}.component-manager-body aside,.component-manager-body main{padding:12px;overflow:auto}.component-manager-body aside{border-right:1px solid var(--border)}.component-previews{display:flex;flex-wrap:wrap}.component-previews canvas{width:100%;max-width:400px;background:#202020}.component-fields{display:flex;gap:8px;flex-wrap:wrap}.component-fields label,.component-inspector label{display:flex;flex-direction:column;gap:4px;margin:8px 0}.library-results{display:flex;flex-wrap:wrap;gap:4px;max-height:280px;overflow:auto}.component-manager table,.component-inspector table{width:100%;text-align:left}.component-manager input,.component-manager select{max-width:100%}.component-inspector{padding:12px;overflow:auto}
.palette.component-manager, .component-manager{resize:both;min-width:min(680px,95vw);min-height:400px}.component-manager tr.selected{background:color-mix(in srgb,#ffcd11 20%,transparent)}

/* Component library workspace */
.palette.component-manager{width:min(1760px,calc(100vw - 48px));height:min(1000px,calc(100dvh - 48px));max-height:calc(100dvh - 48px);min-height:0;min-width:0;overflow:hidden;resize:both}
.component-manager .dialog-header,.component-manager .dialog-actions{flex-shrink:0}
.component-manager-body{display:block;overflow:auto;min-height:0}
.component-manager-body main,.component-configuration{padding:16px;min-width:0}
.component-manager [hidden]{display:none!important}
.component-fields{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.component-browser{border-block:1px solid var(--border);padding-block:12px;margin-block:8px 16px}
.component-browser-controls,.component-pagination,.library-source-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.component-browser-controls label{display:flex;align-items:center;gap:8px}.component-browser-controls label:nth-child(2){flex:1}.component-browser-controls input{width:100%}
.component-manager .library-results{display:block;max-height:200px;overflow:auto;margin-top:8px}
.component-manager table,.library-source-table table{width:100%;border-collapse:collapse;text-align:left}
.component-manager th,.component-manager td,.library-source-table th,.library-source-table td{padding:7px 10px;border-bottom:1px solid var(--border);vertical-align:top}
.component-manager th,.library-source-table th{position:sticky;top:0;background:var(--bg);z-index:1}
.component-manager tbody tr:nth-child(even),.library-source-table tbody tr:nth-child(even){background:var(--surface)}
.component-manager tr.selected{background:color-mix(in srgb,var(--accent,#ffcd11) 18%,transparent)}
.component-pagination{justify-content:flex-end;margin-top:8px}
.component-manager .component-previews{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.component-previews>div{min-width:0;border:1px solid var(--border);padding:10px}
.component-manager .component-previews canvas{display:block;width:100%;max-width:none;aspect-ratio:400/220;background:var(--bg)}
.component-previews h3{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.component-pin-table{max-height:240px;overflow:auto;border:1px solid var(--border)}
.component-manager .component-configuration-button{margin-right:auto}
.component-manager .dialog-actions{flex-wrap:wrap;gap:8px}
.placement-reason{max-width:340px;font-size:12px}
.library-source-table{overflow:auto;margin-block:16px}.library-source-path{overflow-wrap:anywhere;max-width:600px}
@media(max-width:800px){.component-fields{grid-template-columns:repeat(2,minmax(0,1fr))}.component-manager .dialog-actions{padding:8px}}

.component-manager input,.component-manager select{border:1px solid var(--border);background:var(--bg);color:var(--text)}
.component-manager input:focus-visible,.component-manager select:focus-visible{border-color:var(--focus);outline:2px solid var(--focus);outline-offset:1px}
.component-browser-controls [role="tablist"]{display:flex;gap:4px}.component-browser-controls [aria-selected="true"]{border-color:var(--focus)}
