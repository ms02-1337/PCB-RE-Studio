 .component-manager .component-browser .col-pin-count { width: 1%; white-space: nowrap; text-align: center; }
+
+/* Replacement is a single review workspace, independent of the create wizard. */
+.component-manager .component-manager-body > main.component-replacement-mode { overflow: auto; display: block; }
+.component-replacement-mode > h3 { margin: 0 0 10px; }
+.component-replacement-mode > .component-review-info .component-fields { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); }
+.component-replacement-tables { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12px; margin: 12px 0; }
+.component-replacement-browser { min-width: 0; border: 1px solid var(--border); padding: 10px; }
+.component-replacement-browser .component-browser-controls { flex-wrap: wrap; }
+.component-replacement-browser .component-browser-controls label { flex: 1; min-width: 100px; }
+.component-replacement-browser input { width: 100%; height: 30px; padding: 4px 8px; margin: 0; box-sizing: border-box; }
+.component-manager .component-replacement-browser .library-results { height: clamp(130px,20dvh,220px); max-height: 220px; overflow: auto; }
+.component-replacement-browser .col-source,.component-replacement-browser .col-actions { text-align: center; }
+.component-replacement-browser .col-actions { width: 1%; white-space: nowrap; }
+.component-replacement-mode .component-workspace { min-height: 0; flex: none; display: block; }
+.component-replacement-mode .component-preview-stage { display: block; }
+.component-replacement-mode .component-previews { height: clamp(200px,25dvh,300px); }
+.component-replacement-mode .component-review-bottom { display: block; min-height: 0; }
+.component-replacement-mode .component-review-pins { margin-top: 12px; }
+.component-replacement-mode .component-review-pins .component-pin-table { max-height: 240px; overflow: auto; }
+@media(max-width:800px) { .component-replacement-mode > .component-review-info .component-fields { grid-template-columns:repeat(2,minmax(0,1fr)); } }
